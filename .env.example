# ---- LLM Provider Keys (used via LiteLLM) ----
# Set whichever provider key(s) match the models you configure below.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ---- Web Search Provider ----
TAVILY_API_KEY=tvly-your-tavily-key

# ---- Model selection ----
# Any LiteLLM-supported model string, e.g. "gpt-4o-mini", "gpt-4o",
# "claude-sonnet-4-6". RESEARCH_MODEL powers the planner + critic loop;
# WRITER_MODEL powers the final report synthesis (can be the same model).
RESEARCH_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o-mini

# ---- Search tuning ----
MAX_SEARCH_RESULTS_PER_QUERY=5
SEARCH_TIMEOUT_SECONDS=30

# ---- Observability (optional — leave blank to disable LangSmith tracing) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deep-research-agent

# ---- Frontend ----
# URL the Streamlit UI uses to reach the FastAPI backend.
BACKEND_URL=http://localhost:8000
